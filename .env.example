NEXT_PUBLIC_SITE_URL=https://saranshsharma.me

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=3dxvlt1d
NEXT_PUBLIC_SANITY_DATASET=production
# Optional for the website (reads are public). Only needed if you want
# new subscribers written to Sanity from the site. If set, create a
# token with read+write permissions in Sanity Manage → API → Tokens.
SANITY_API_TOKEN=

# REQUIRED in production: signs the reader-access cookie and the
# email verification links. Generate with `openssl rand -hex 32`.
READER_COOKIE_SECRET=

# REQUIRED for the subscribe flow: sends the confirmation/sign-in
# emails via Resend. Create a key at https://resend.com (Email sending scope)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional anti-abuse knobs for the subscribe/verify email limits
# (per-hour and per-day caps on how many verification emails the site
# will send across ALL subscribers — protects the Resend quota).
EMAIL_HOURLY_LIMIT=10
EMAIL_DAILY_LIMIT=50
